<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/widget_title_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_title_background"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <include
                android:id="@+id/task_list_title_container"
                layout="@layout/task_widget_title" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/task_list_gap"
        android:layout_width="match_parent"
        android:layout_height="2dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/widget_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_background"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp">

            <ListView
                android:id="@+id/task_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp" />

            <TextView
                android:id="@+id/empty_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/task_widget_empty"
                android:textSize="16sp"
                android:textColor="@color/widget_empty_text" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
